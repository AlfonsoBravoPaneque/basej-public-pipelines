nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("rna_qc_GRCh38_test") {
        when {
            params {
                outputDir   = "${outputDir}"
                workspace   = "demo"
                workflow_id = "test_GRCh38"
                input_csv   = "$baseDir/tests/data/inputs/input_rnaTest2.csv"
                max_memory  = "50.GB"
                max_cpus    = "8"
                genome      = "GRCh38"
                n_reads     = 500000
            }
        }

        then {
            assertAll(

                { assert workflow.success },

                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/reports/multiqc_report.html").exists() },

                // Check rnaqc_all_metrics.tsv - full-schema TSV for nf-test validation
                {
                    def f = path("${outputDir}/workflow_outputs/demo/test_GRCh38/metrics/rnaqc_metrics/rnaqc_all_metrics.tsv")
                    assert f.exists()
                    def lines  = f.readLines()
                    def header = lines[0].split('\t').toList()

                    // Required columns must be present
                    ['qc_score', 'qc_status', 'mt_pct', 'star_uniquely_mapped_pct',
                     'total_reads', 'final_reads', 'subsampled',
                     'genes_detected_total', 'genes_protein_coding',
                     'prop_mappability', 'prop_exonic', 'prop_intergenic', 'prop_intronic'].each { col ->
                        assert header.contains(col) : "Missing column: ${col}"
                    }

                    def idx = { col -> header.indexOf(col) }

                    // Expected per-sample values with n_reads=500000 subsampling.
                    // TOTAL_READS = R1+R2 combined; FINAL_READS = R1 reads after seqkit (per-end).
                    // Samples with total_reads > 500000 are subsampled (07H at 429114 is not).
                    def expected = [
                        'ResolveOMEv2.1-RNA-04C': [total_reads: 716600,  final_reads: 250201,  subsampled: 'True',  qc_status: 'PASS', qc_score: 5],
                        'ResolveOMEv2.1-RNA-04E': [total_reads: 894242,  final_reads: 250121,  subsampled: 'True',  qc_status: 'PASS', qc_score: 5],
                        'ResolveOMEv2.1-RNA-06B': [total_reads: 584196,  final_reads: 250095,  subsampled: 'True',  qc_status: 'PASS', qc_score: 4],
                        'ResolveOMEv2.1-RNA-07H': [total_reads: 429114,  final_reads: 429114,  subsampled: 'False', qc_status: 'PASS', qc_score: 5],
                        'ResolveOMEv2.1-RNA-08B': [total_reads: 779982,  final_reads: 250068,  subsampled: 'True',  qc_status: 'PASS', qc_score: 5],
                    ]

                    assert lines.size() - 1 == expected.size() : "Expected ${expected.size()} samples, got ${lines.size() - 1}"

                    for (int i = 1; i < lines.size(); i++) {
                        def cols   = lines[i].split('\t', -1)
                        def sample = cols[0]
                        def exp    = expected[sample]
                        assert exp != null : "Unexpected sample in rnaqc_all_metrics.tsv: ${sample}"

                        assert cols[idx('total_reads')].trim().toLong() == exp.total_reads : "total_reads mismatch for ${sample}"
                        assert cols[idx('final_reads')].trim().toLong() == exp.final_reads : "final_reads mismatch for ${sample}"
                        assert cols[idx('subsampled')].trim()           == exp.subsampled  : "subsampled mismatch for ${sample}"
                        assert cols[idx('qc_status')].trim()            == exp.qc_status   : "qc_status mismatch for ${sample}"
                        assert cols[idx('qc_score')].trim().toInteger() == exp.qc_score    : "qc_score mismatch for ${sample}"

                        // mt_pct must be a fraction (0-1) — regression: was stored as percentage before
                        def mtPct = cols[idx('mt_pct')].trim()
                        if (mtPct && mtPct != 'None') {
                            assert mtPct.toDouble() >= 0.0 && mtPct.toDouble() <= 1.0 : "mt_pct not a fraction for ${sample}: ${mtPct}"
                        }

                        // star_uniquely_mapped_pct is a percentage (STAR native format); sanity-check alignment quality
                        def starPct = cols[idx('star_uniquely_mapped_pct')].trim()
                        if (starPct && starPct != 'None') {
                            assert starPct.toDouble() > 50.0 : "star_uniquely_mapped_pct too low for ${sample}: ${starPct}"
                        }

                        // genes_protein_coding must be a positive count
                        def proteinCoding = cols[idx('genes_protein_coding')].trim()
                        if (proteinCoding && proteinCoding != 'None') {
                            assert proteinCoding.toLong() > 0 : "genes_protein_coding should be > 0 for ${sample}"
                        }

                        // Qualimap-derived scoring proportions — exact values from last validated run
                        def expectedProps = [
                            'ResolveOMEv2.1-RNA-04C': [prop_mappability: 0.8655, prop_exonic: 0.7183, prop_intergenic: 0.0338, prop_intronic: 0.2172],
                            'ResolveOMEv2.1-RNA-04E': [prop_mappability: 0.8449, prop_exonic: 0.7838, prop_intergenic: 0.0173, prop_intronic: 0.1659],
                            'ResolveOMEv2.1-RNA-06B': [prop_mappability: 0.6487, prop_exonic: 0.7174, prop_intergenic: 0.0272, prop_intronic: 0.2152],
                            'ResolveOMEv2.1-RNA-07H': [prop_mappability: 0.7925, prop_exonic: 0.7332, prop_intergenic: 0.0203, prop_intronic: 0.2117],
                            'ResolveOMEv2.1-RNA-08B': [prop_mappability: 0.8503, prop_exonic: 0.7184, prop_intergenic: 0.0301, prop_intronic: 0.2176],
                        ]
                        def expProps = expectedProps[sample]
                        if (expProps) {
                            ['prop_mappability', 'prop_exonic', 'prop_intergenic', 'prop_intronic'].each { propCol ->
                                def val = cols[idx(propCol)].trim()
                                assert val && val != 'None' && val != '' : "${propCol} missing for ${sample}"
                                assert Math.abs(val.toDouble() - expProps[propCol]) < 0.0001 : "${propCol} mismatch for ${sample}: expected ${expProps[propCol]}, got ${val}"
                            }
                        }
                    }
                },

                // Verify rnaqc_summary parquet files exist for all samples
                {
                    assert path("${outputDir}/tables/rnaqc_summary/workspace=demo/workflow_id=test_GRCh38/biosample=ResolveOMEv2.1-RNA-04C/output.parquet").exists()
                    assert path("${outputDir}/tables/rnaqc_summary/workspace=demo/workflow_id=test_GRCh38/biosample=ResolveOMEv2.1-RNA-04E/output.parquet").exists()
                    assert path("${outputDir}/tables/rnaqc_summary/workspace=demo/workflow_id=test_GRCh38/biosample=ResolveOMEv2.1-RNA-06B/output.parquet").exists()
                    assert path("${outputDir}/tables/rnaqc_summary/workspace=demo/workflow_id=test_GRCh38/biosample=ResolveOMEv2.1-RNA-07H/output.parquet").exists()
                    assert path("${outputDir}/tables/rnaqc_summary/workspace=demo/workflow_id=test_GRCh38/biosample=ResolveOMEv2.1-RNA-08B/output.parquet").exists()
                },

                { assert path("${outputDir}/tables/gene_count_summary/workspace=demo/workflow_id=test_GRCh38/output.parquet").exists() },

                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/qc_plots/pca_heatmap/PCA_mqc.png").exists() },
                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/qc_plots/pca_heatmap/Heatmap__mqc.png").exists() },
                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/qc_plots/pca_heatmap/MT_mqc.png").exists() },
                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/qc_plots/pca_heatmap/GenesDetected_mqc.png").exists() },
                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/qc_plots/RNAQC_composition_mqc.jpg").exists() },

                // Protein / ADT CPM outputs (ResolveDOGMA)
                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/protein_cpm/protein_adt_cpm.tsv").exists() },
                { assert path("${outputDir}/workflow_outputs/demo/test_GRCh38/protein_cpm/protein_adt_raw_counts.tsv").exists() },
                { assert path("${outputDir}/tables/protein_cpm_summary/workspace=demo/workflow_id=test_GRCh38/biosample=ResolveOMEv2.1-RNA-04C/output.parquet").exists() }
            )
        }
    }

}
